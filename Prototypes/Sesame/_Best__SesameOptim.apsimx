        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using Models.Soils.Nutrients;",
            "using APSIM.Shared.Utilities;",
            "using Models.Surface;",
            "using Models.Utilities;",
            "using Models.Soils.Nutrients;",
            "using Models.Soils;",
            "using Models.PMF;",
            "using Models.Core;",
            "using System;",
            "using System.Linq;",
            "using Models.Interfaces;",
            "",
            "namespace Models",
            "{",
            "\t[Serializable]",
            "\tpublic class Script : Model",
            "\t{",
            "\t\t[Link] private Clock Clock;",
            "\t\t[Link] private IWeather Weather;",
            "\t\t",
            "\t\t[Description(\"Coefficient of x^3\")]",
            "\t\tpublic double C3 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Coefficient of x^2\")]",
            "\t\tpublic double C2 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Coefficient of x)\")]",
            "\t\tpublic double C1 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Intercept\")]",
            "\t\tpublic double C0 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Target period (negative to use regression; set 0 to keep at 350 ppm; or 2030-2050)\")]",
            "\t\tpublic double Target {get; set;}",
            "\t\t",
            "\t\t[Description(\"RCP scenario (only used if Target>0)\")]",
            "\t\tpublic string RCP {get; set;}",
            "\t\t",
            "\t\t[Description(\"Keep CO2 at this level (only used if Target<0; negative to ignore)\")]",
            "\t\tpublic double KeepAt {get; set;}",
            "\t\t",
            "\t\t[Description(\"Keep CO2 at this year's level (only used if Target<0; negative to ignore)\")]",
            "\t\tpublic double KeepAtYear {get; set;}",
            "\t\tprivate double CO2;",
            "\t\tprivate double MonID;",
            "\t\t",
            "\t\t[EventSubscribe(\"DoWeather\")]",
            "\t\tprivate void OnDoWeather(object sender, EventArgs e)",
            "\t\t{",
            "\t\t\tCO2 = -1;",
            "\t\t\tif (Target == 0)",
            "\t\t\t{",
            "\t\t\t\tCO2 = 350;",
            "\t\t\t}",
            "\t\t\telse if (Target > 0)",
            "\t\t\t{",
            "\t\t\t\tif (Target == 2030)",
            "\t\t\t\t{",
            "\t\t\t\t\tif (RCP == \"RCP45\")",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 438;",
            "\t\t\t\t\t}",
            "\t\t\t\t\telse",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 452;",
            "\t\t\t\t\t}",
            "\t\t\t\t}",
            "\t\t\t\telse if (Target == 2050)",
            "\t\t\t\t{",
            "\t\t\t\t\tif (RCP == \"RCP45\")",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 483;",
            "\t\t\t\t\t}",
            "\t\t\t\t\telse",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 546;",
            "\t\t\t\t\t}",
            "\t\t\t\t}",
            "\t\t\t}",
            "\t\t\telse if (Target < 0)",
            "\t\t\t{",
            "\t\t\t\tif (KeepAt < 0)",
            "\t\t\t\t{",
            "\t\t\t\t\tif (KeepAtYear < 0)",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tMonID = (Clock.Today.Year - 1) * 12 + (Clock.Today.Month - 1) + (Clock.Today.Day / 30) - 23483.5;",
            "\t\t\t\t\t}",
            "\t\t\t\t\telse",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tMonID = (KeepAtYear - 1) * 12 + 1 - 23483.5;",
            "\t\t\t\t\t}",
            "\t\t\t\t\tCO2 = (C3 * Math.Pow(MonID,3)) + (C2 * Math.Pow(MonID,2)) + (C1 * MonID) + C0;",
            "\t\t\t\t}",
            "\t\t\t\telse",
            "\t\t\t\t{",
            "\t\t\t\t\tCO2 = KeepAt;",
            "\t\t\t\t}",
            "\t\t\t\tif (CO2 < 350)",
            "\t\t\t\t{",
            "\t\t\t\t\tCO2 = 350;",
            "\t\t\t\t}",
            "\t\t\t}",
            "\t\t\tWeather.CO2 = CO2;",
            "\t\t}",
            "\t}",
            "}"
          ],
          "Parameters": [
            {
              "Key": "C3",
              "Value": "1.4507E-08"
            },
            {
              "Key": "C2",
              "Value": "8.0117411E-05"
            },
            {
              "Key": "C1",
              "Value": "0.057666049"
            },
            {
              "Key": "C0",
              "Value": "314.802402"
            },
            {
              "Key": "Target",
              "Value": "-1"
            },
            {
              "Key": "RCP",
              "Value": "RCP85"
            },
            {
              "Key": "KeepAt",
              "Value": "-1"
            },
            {
              "Key": "KeepAtYear",
              "Value": "-1"
            }
          ],
          "Name": "CO2Trend",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
