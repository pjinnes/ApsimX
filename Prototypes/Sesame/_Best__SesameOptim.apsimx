                    {
                      "$type": "Models.Functions.MultiplyFunction, Models",
                      "Name": "FT",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Functions.WeightedTemperatureFunction, Models",
                          "MaximumTemperatureWeighting": 0.5,
                          "Name": "MeanT",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Memo, Models",
                              "Text": "The cardinal temperature limits of 15.7 °C (Tmin), 27.3 °C (Topt), and 44.6 °C (Tmax) were observed for rate of biomass accumulation.\n\n- Baath, G. S., Kakani, V. G., Northup, B. K., Gowda, P. H., Rocateli, A. C., & Singh, H. (2022). Quantifying and Modeling the Influence of Temperature on Growth and Reproductive Development of Sesame. Journal of Plant Growth Regulation, 41(1), 143–152. https://doi.org/10.1007/s00344-020-10278-y.",
                              "Name": "Memo",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Functions.XYPairs, Models",
                              "X": [
                                15.7,
                                27.3,
                                44.6
                              ],
                              "Y": [
                                0.0,
                                1.0,
                                0.0
                              ],
                              "Name": "XYPairs",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Functions.LinearInterpolationFunction, Models",
                          "Name": "MinT",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Memo, Models",
                              "Text": "Sesame will dry down 120-150 days without a frost. It will dry down sooner with a frost or freeze. Although sesame is indeterminate, it will terminate and self-defoliate without a frost. A frost will cause the plants to drydown more rapidly than normal. Just like cotton and sorghum, a frost will terminate the crop and prepare the crop for harvest earlier than when compared to temperatures remaining just above freezing. Rule of thumb is that you need 130 days from the time that the soil temperature is 70ºF (21ºC) and the first frost date. From planting, sesame needs about 110 days of night temperatures above 40ºF (4.5ºC). Sesame needs to reach physiological maturity prior to frost to make optimum yield.\n\n- SESAME GROWER GUIDE. D. Ray Langham, Jerry Riney, Glenn Smith, and Terry Wiemers. March 2008. www.sesaco.net. ",
                              "Name": "Memo",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Functions.XYPairs, Models",
                              "X": [
                                -4.0,
                                0.0,
                                4.5,
                                10.0
                              ],
                              "Y": [
                                0.0,
                                0.0,
                                1.0,
                                1.0
                              ],
                              "Name": "XYPairs",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
                            {
                              "$type": "Models.Functions.VariableReference, Models",
                              "VariableName": "[Weather].MinT",
                              "Name": "XValue",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            }
                          ],
                          "Enabled": true,
                          "ReadOnly": false
                        }
