                                0.0,
                                4.5,
                                10.0
                              ],
                              "Y": [
                                1.5,
                                1.2,
                                1.0,
                                1.0
                              ],
                              "XVariableName": null,
                              "Name": "XYPairs",
                              "ResourceName": null,
                              "Children": [],
                              "Enabled": true,
                              "ReadOnly": false
                            },
