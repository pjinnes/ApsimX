                        {
                          "$type": "Models.Manager, Models",
                          "CodeArray": [
                            "",
                            "using Models.Soils;",
                            "using System;",
                            "using Models.Core;",
                            "using Models.PMF;",
                            "using APSIM.Shared.Utilities;",
                            "using Models;",
                            "",
                            "        ",
                            "    namespace Models",
                            "    {",
                            "        [Serializable] ",
                            "        [System.Xml.Serialization.XmlInclude(typeof(Model))]",
                            "        public class Script : Model",
                            "        {      ",
                            "           [Link] Plant Sesame;",
                            "           [Link] Clock Clock;",
                            "           [Link] Fertiliser Fert;",
                            "           [Link] Irrigation Irrig;",
                            "           [Link] private Summary summary;",
                            "           ",
                            "           [Separator(\"Set sowing parameters\")]",
                            "           [Description(\"Spacing (mm) between rows\")]",
                            "           public double RowSpacing { get; set; }",
                            "           [Description(\"Depth (mm) seeds are planted\")]",
                            "           public double SowingDepth { get; set; }",
                            "           [Description(\"Seed sowing density (/m2)\")]",
                            "           public double SowingRate { get; set; }",
                            "           [Description(\"Cultivar\")]",
                            "           [Display(Type=DisplayType.CultivarName)]",
                            "           public string CultivarName { get; set; }",
                            "           [Description(\"Sowing Date\")]",
                            "           public String SowingDate { get; set; }",
                            "           [Description(\"Type of fertiliser to apply\")]",
                            "           [Display(Type = DisplayType.FertiliserType)]",
                            "           public string FertType { get; set; }",
                            "           [Description(\"Sowing Fertiliser amount (kg)\")]",
                            "           public double SowingFert { get; set; }            ",
                            "           [Description(\"Irrigation sowing amount (mm)\")]",
                            "           public double SowingIrrigationAmount { get; set; }",
                            "           ",
                            "           [Separator(\"Set irrigation on one or more dates dd-mmm on every year of the simulation, e.g., 01-jan, 20-feb\")]",
                            "           [Description(\"Enter the irrigation dates as dd-mmm with comma separation (any year information entered will be ignored)\")] ",
                            "           public string[] IrrigateDates { get; set; }       ",
                            "           [Description(\"Amount of irrigation to be applied (mm)\")] ",
                            "           public double IrrigationAmount { get; set; }        ",
                            "           [Description(\"Depth in the soil to apply the  irrigation (mm)\")] ",
                            "           public double Depth { get; set; }      ",
                            "           [Description(\"Efficiency of irrigation (0-1)\")] ",
                            "           public double Efficiency { get; set; }       ",
                            "           [Description(\"Will the irrigation runoff?\")] ",
                            "           public bool WillRunoff { get; set; }",
                            "               ",
                            "             ",
                            "           [Separator(\"Apply fertiliser on one or more dates dd-mmm on every year of the simulation\")]",
                            "           [Description(\"Enter the fertiliser dates as dd-mmm with comma separation (any year information entered will be ignored)\")] ",
                            "           public string[] FertiliseDates { get; set; }       ",
                            "           [Description(\"Amount of fertiliser to be applied (kg)\")] ",
                            "           public double FertiliseAmount { get; set; }",
                            "           ",
                            "           [Separator(\"Harvest and end simulation dates\")]",
                            "           [Description(\"Set the harvest date\")]",
                            "           public String HarvestDate { get; set; }",
                            "           [Description(\"Set the end simulation date\")]",
                            "           public String EndCropDate { get; set; }",
                            "            ",
                            "           [EventSubscribe(\"DoManagement\")]",
                            "           private void OnDoManagement(object sender, EventArgs e)",
                            "           {            ",
                            "               //if (Clock.Today.Date == SowingDate)",
                            "               if (DateUtilities.WithinDates(SowingDate, Clock.Today, SowingDate))",
                            "               {",
                            "                   Sesame.Sow(population:SowingRate, cultivar:CultivarName, depth:SowingDepth, rowSpacing:RowSpacing);",
                            "                   Fert.Apply(SowingFert, FertType,0);",
                            "                   Irrig.Apply(SowingIrrigationAmount, 0);",
                            "               }",
                            "           ",
                            "               foreach (string ddMMM in IrrigateDates)",
                            "               {",
                            "                   if (DateUtilities.DatesEqual(ddMMM, Clock.Today))",
                            "                       Irrig.Apply(amount: IrrigationAmount, depth: Depth, efficiency: Efficiency, willRunoff: WillRunoff);",
                            "               }",
                            "                          ",
                            "               foreach (string ddMMM in FertiliseDates)",
                            "               {",
                            "                   if (DateUtilities.DatesEqual(ddMMM, Clock.Today))",
                            "                       Fert.Apply(FertiliseAmount, FertType, 0);",
                            "               }",
                            "               ",
                            "               if (DateUtilities.WithinDates(HarvestDate, Clock.Today, HarvestDate))",
                            "               {",
                            "                   Sesame.Harvest();",
                            "               }   ",
                            "               ",
                            "               if (DateUtilities.WithinDates(EndCropDate, Clock.Today, EndCropDate))",
                            "               {",
                            "                   Sesame.EndCrop();",
                            "               }           ",
                            "           }",
                            "       }",
                            "   }",
                            "                "
                          ],
                          "Parameters": [
                            {
                              "Key": "RowSpacing",
                              "Value": "500"
                            },
                            {
                              "Key": "SowingDepth",
                              "Value": "30"
                            },
                            {
                              "Key": "SowingRate",
                              "Value": "40"
                            },
                            {
                              "Key": "CultivarName",
                              "Value": "S57B"
                            },
                            {
                              "Key": "SowingDate",
                              "Value": "01/01/0001 00:00:00"
                            },
                            {
