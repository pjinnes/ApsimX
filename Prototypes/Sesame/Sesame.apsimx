        {
          "$type": "Models.Report, Models",
          "VariableNames": [
            "[Clock].Today",
            "[Clock].Today.DayOfYear",
            "[Clock].Today.Year as HarvestYear",
            "",
            "[Sesame].DaysAfterSowing as DaysAfterSowing",
            "[Sesame].SowingData.Population as Population",
            "",
            "[Sesame].Phenology.Stage",
            "[Sesame].Phenology.AccumulatedTT",
            "[Sesame].Phenology.EmergenceDAS",
            "[Sesame].Phenology.StartFloweringDAS",
            "[Sesame].Phenology.MaturityDAS",
            "[Sesame].Stem.BranchNumber as BranchNumber",
            "[Sesame].Stem.NodeNumber",
            "",
            "//[Irrigation].IrrigationEvents as NumberIrrig",
            "sum of [Irrigation].IrrigationApplied from [Sesame].Sowing to [Sesame].Harvesting as TotalIrrig",
            "",
            "max of [Sesame].Leaf.LAI from [Sesame].Sowing to [Sesame].Harvesting as MaxLAI",
            "",
            "mean of [Sesame].Leaf.Photosynthesis.FT from [Sesame].Sowing to [Sesame].Harvesting as AvePsFT",
            "mean of [Sesame].Leaf.Photosynthesis.FT.MeanT from [Sesame].Sowing to [Sesame].Harvesting as AvePsFTMeanT",
            "mean of [Sesame].Leaf.Photosynthesis.FT.MinT from [Sesame].Sowing to [Sesame].Harvesting as AvePsFTMinT",
            "mean of [Sesame].Leaf.Photosynthesis.FN from [Sesame].Sowing to [Sesame].Harvesting as AvePsFN",
            "mean of [Sesame].Leaf.Photosynthesis.FW from [Sesame].Sowing to [Sesame].Harvesting as AvePsFW",
            "mean of [Sesame].Root.WetRootFractionFactor from [Sesame].Sowing to [Sesame].Harvesting as AveWetRootFracFact",
            "mean of [Sesame].Leaf.FW from [Sesame].Sowing to [Sesame].Harvesting as AveFW",
            "mean of [Sesame].Leaf.FRGR from [Sesame].Sowing to [Sesame].Harvesting as AveFRGR",
            "",
            "[Sesame].AboveGround.Wt as AboveGroundWt",
            "[Sesame].Grain.Wt as GrainWt"
          ],
          "EventNames": [
            "[Sesame].Harvesting"
          ],
          "GroupByVariableName": null,
          "Name": "HarvestReport",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using Models.Soils.Nutrients;",
            "using APSIM.Shared.Utilities;",
            "using Models.Surface;",
            "using Models.Utilities;",
            "using Models.Soils.Nutrients;",
            "using Models.Soils;",
            "using Models.PMF;",
            "using Models.Core;",
            "using System;",
            "using System.Linq;",
            "using Models.Interfaces;",
            "",
            "namespace Models",
            "{",
            "    [Serializable]",
            "    public class Script : Model",
            "    {",
            "        [Link] private Clock Clock;",
            "        [Link] private ISoilWater soilWater;",
            "        [Link] private SoilCrop soilCrop;",
            "        [Link] private Physical soilPhysical;",
            "        [Link] private Nutrient nutrient;",
            "        [Link] private Organic organic;",
            "        [Link] private SurfaceOrganicMatter SOM;",
            "        [Link] private Summary summary;",
            "",
            "        //===================================================================================================================        ",
            "",
            "        [Description(\"Reset date for soil moisture (e.g., 01-may or blank)\")]",
            "        public string ResetDateSM { get; set; }",
            "",
            "        [Description(\"Reset date for soil N, C, and SOM (e.g., 01-may or blank)\")]",
            "        public string ResetDateCN { get; set; }",
            "",
            "        [Description(\"Initial cumulative depths (mm)\")]",
            "        public double[] InitDepth { get; set; }",
            "",
            "        [Description(\"Initial gravitational water content (g/g)\")]",
            "        public double[] InitWater { get; set; } = new double[0];",
            "",
            "        [Description(\"Initial NO3N (mg/kg)\")]",
            "        public double[] InitNO3N { get; set; } = new double[0];",
            "",
            "        [Description(\"Initial NH4N (mg/kg)\")]",
            "        public double[] InitNH4N { get; set; } = new double[0];",
            "",
            "        [Description(\"Initial OC (%)\")]",
            "        public double[] InitOC { get; set; } = new double[0];",
            "",
            "        //===================================================================================================================        ",
            "",
            "        private double[] MidLayerDepth;",
            "        private bool ResetSM = false;",
            "        private bool ResetCN = false;",
            "        private bool ResetSOM = false;",
            "",
            "        //===================================================================================================================",
            "",
            "        [EventSubscribe(\"StartOfSimulation\")]",
            "        private void OnStartOfSimulation(object sender, EventArgs args)",
            "        {",
            "            // summary.WriteMessage(this, \"Brian0: \" + string.IsNullOrEmpty(ResetDateCN), MessageType.Diagnostic);",
            "            ",
            "            if (!string.IsNullOrEmpty(ResetDateSM))",
            "                ResetSM = true;",
            "            else",
            "            {",
            "                ResetSM = false;",
            "                ResetDateSM = \"01-jan\";",
            "            }",
            "",
            "            if (!string.IsNullOrEmpty(ResetDateCN))",
            "            {",
            "                ResetCN = true;",
            "                ResetSOM = true;",
            "            }",
            "            else",
            "            {",
            "                ResetCN = false;",
            "                ResetSOM = false;",
            "                ResetDateCN = \"01-jan\";",
            "            }",
            "",
            "            if (InitDepth is null) InitDepth = new double[0];",
            "            if (InitWater is null) InitWater = new double[0];",
            "            if (InitNO3N is null) InitNO3N = new double[0];",
            "            if (InitNH4N is null) InitNH4N = new double[0];",
            "            if (InitOC is null) InitOC = new double[0];",
            "            ",
            "            MidLayerDepth = new double[InitDepth.Length];",
            "            double x1, x2, cumDepth;",
            "",
            "            for (int layer = 0; layer < InitDepth.Length; layer++)",
            "            {",
            "                if (layer == 0)",
            "                {",
            "                    x1 = 0;",
            "                }",
            "                else",
            "                {",
            "                    x1 = InitDepth[layer - 1];",
            "                }",
            "                x2 = InitDepth[layer];",
            "                cumDepth = x1 + 0.5 * (x2 - x1);",
            "                MidLayerDepth[layer] = cumDepth;",
            "            }",
            "",
            "            // summary.WriteMessage(this, \"Brian1: \" + string.Join(\", \", InitWater), MessageType.Diagnostic);",
            "            ",
            "            if (InitWater.Length == 1) InitWater = Enumerable.Repeat(InitWater[0], MidLayerDepth.Length).ToArray();",
            "            if (InitNO3N.Length == 1) InitNO3N = Enumerable.Repeat(InitNO3N[0], MidLayerDepth.Length).ToArray();",
            "            if (InitNH4N.Length == 1) InitNH4N = Enumerable.Repeat(InitNH4N[0], MidLayerDepth.Length).ToArray();",
            "            if (InitOC.Length == 1) InitOC = Enumerable.Repeat(InitOC[0], MidLayerDepth.Length).ToArray();",
            "",
            "            InitWater = InterpolateInitValues(InitWater, 4);",
            "            InitNO3N = InterpolateInitValues(InitNO3N, 2);",
            "            InitNH4N = InterpolateInitValues(InitNH4N, 2);",
            "            InitOC = InterpolateInitValues(InitOC, 2);",
            "            ",
            "            // summary.WriteMessage(this, \"Brian2: \" + string.Join(\", \", InitWater), MessageType.Diagnostic);",
            "        }",
            "",
            "        //===================================================================================================================",
            "",
            "        [EventSubscribe(\"StartOfDay\")]",
            "        private void OnStartOfDay(object sender, EventArgs e)",
            "        {",
            "            DateTime resetDateSM = DateUtilities.GetDate(ResetDateSM, Clock.Today);",
            "            DateTime resetDateCN = DateUtilities.GetDate(ResetDateCN, Clock.Today);",
            "",
            "            // Rset soil moisture on the reset date for soil moisture.",
            "            if (ResetSM && resetDateSM.Equals(Clock.Today))",
            "            {",
            "                summary.WriteMessage(this, \"Reset soil moisture content.\", MessageType.Diagnostic);",
            "                ",
            "                if (InitWater.Length > 0)",
            "                {",
            "                    double x1, x2, depth;",
            "                    int nLayers = soilPhysical.DUL.Length;",
            "",
            "                    double[] newSW = new double[soilPhysical.DUL.Length];",
            "                    if (InitWater.Length > 0) soilWater.SW = new double[soilWater.SW.Length];",
            "",
            "                    for (int layer = 0; layer < nLayers; layer++)",
            "                    {",
            "                        if (layer == 0)",
            "                        {",
            "                            x1 = 0;",
            "                        }",
            "                        else",
            "                        {",
            "                            x1 = soilPhysical.ThicknessCumulative[layer - 1];",
            "                        }",
            "",
            "                        x2 = soilPhysical.ThicknessCumulative[layer];",
            "                        depth = 0.5 * (x1 + x2);",
            "",
            "                        if (InitWater.Length > 0)",
            "                        {",
            "                            newSW[layer] = LinearInterpolate(depth, MidLayerDepth, InitWater, 4);",
            "                            newSW[layer] = newSW[layer] * soilPhysical.BD[layer];",
            "                            newSW[layer] = Math.Min(newSW[layer], soilPhysical.DUL[layer]);                            ",
            "                        }",
            "                    }",
            "",
            "                    if (InitWater.Length > 0) soilWater.SW = newSW;",
            "                }",
            "            }",
            "",
            "            // summary.WriteMessage(this, \"Brian2: \" + ResetCN, MessageType.Diagnostic);",
            "            // summary.WriteMessage(this, \"Brian2: \" + resetDateCN, MessageType.Diagnostic);",
            "            ",
            "            // Reset soil N and C on the reset date for N and C.",
            "            if (ResetCN && resetDateCN.Equals(Clock.Today))",
            "            {",
            "                summary.WriteMessage(this, \"Reset soil N and C content.\", MessageType.Diagnostic);",
            "                nutrient.Reset();",
            "",
            "                if (InitNO3N.Length > 0 || InitNH4N.Length > 0 || InitOC.Length > 0)",
            "                {",
            "                    double x1, x2, depth;",
            "                    int nLayers = nutrient.NO3.kgha.Length;",
            "",
            "                    double[] newNO3 = new double[nutrient.NO3.kgha.Length];",
            "                    double[] newNH4 = new double[nutrient.NH4.kgha.Length];",
            "                    double[] newOC = new double[organic.Carbon.Length];",
            "",
            "                    if (InitNO3N.Length > 0) nutrient.NO3.kgha = new double[nutrient.NO3.kgha.Length];",
            "                    if (InitNH4N.Length > 0) nutrient.NH4.kgha = new double[nutrient.NH4.kgha.Length];",
            "                    if (InitOC.Length > 0) organic.Carbon = new double[organic.Carbon.Length];",
            "",
            "                    for (int layer = 0; layer < nLayers; layer++)",
            "                    {",
            "                        if (layer == 0)",
            "                        {",
            "                            x1 = 0;",
            "                        }",
            "                        else",
            "                        {",
            "                            x1 = soilPhysical.ThicknessCumulative[layer - 1];",
            "                        }",
            "",
            "                        x2 = soilPhysical.ThicknessCumulative[layer];",
            "                        depth = 0.5 * (x1 + x2);",
            "",
            "                        if (InitNO3N.Length > 0)",
            "                        {",
            "                            newNO3[layer] = LinearInterpolate(depth, MidLayerDepth, InitNO3N, 2);",
            "                            newNO3[layer] = newNO3[layer] * soilPhysical.BD[layer] * soilPhysical.Thickness[layer] / 10;",
            "                        }",
            "                        if (InitNH4N.Length > 0)",
            "                        {",
            "                            newNH4[layer] = LinearInterpolate(depth, MidLayerDepth, InitNH4N, 2);",
            "                            newNH4[layer] = newNH4[layer] * soilPhysical.BD[layer] * soilPhysical.Thickness[layer] / 10;",
            "                        }",
            "                        if (InitOC.Length > 0)",
            "                        {",
            "                            newOC[layer] = LinearInterpolate(depth, MidLayerDepth, InitOC, 2);",
            "                        }",
            "                    }",
            "",
            "                    if (InitNO3N.Length > 0) nutrient.NO3.kgha = newNO3;",
            "                    if (InitNH4N.Length > 0) nutrient.NH4.kgha = newNH4;",
            "                    if (InitOC.Length > 0) organic.Carbon = newOC;",
            "                    ",
            "                    // summary.WriteMessage(this, \"Brian3: \" + string.Join(\", \", nutrient.NO3.kgha), MessageType.Diagnostic);",
            "                }",
            "",
            "                if (ResetSOM && resetDateCN.Equals(Clock.Today))",
            "                {",
            "                    summary.WriteMessage(this, \"Reset surface OM.\", MessageType.Diagnostic);",
            "                    SOM.Reset();",
            "                }",
            "            }",
            "        }",
            "",
            "        //===================================================================================================================",
            "",
            "        public double LinearInterpolate(double x, double[] xValues, double[] yValues, int numDig = 3)",
            "        {",
            "            if (x <= xValues[0]) return yValues[0];",
            "            if (x >= xValues[xValues.Length - 1]) return yValues[yValues.Length - 1];            ",
            "            ",
            "            for (int i = 1; i < xValues.Length; i++)",
            "            {",
            "                if (x < xValues[i])",
            "                {",
            "                    double x0 = xValues[i - 1];",
            "                    double x1 = xValues[i];",
            "                    double y0 = yValues[i - 1];",
            "                    double y1 = yValues[i];",
            "                    return Math.Round(y0 + (y1 - y0) * (x - x0) / (x1 - x0), numDig);",
            "                }",
            "            }",
            "            return yValues[yValues.Length - 1];",
            "        }",
            "",
            "        public double[] InterpolateInitValues(double[] InputArray, int numDig = 3)",
            "        {            ",
            "            if (InputArray.Length == 2 && MidLayerDepth.Length > 2)",
            "            {                ",
            "                double[] newVals = new double[MidLayerDepth.Length];",
            "                double[] newDepths = new double[] { MidLayerDepth[0], MidLayerDepth[MidLayerDepth.Length - 1] };                ",
            "                ",
            "                newVals[0] = InputArray[0];",
            "                newVals[newVals.Length - 1] = InputArray[1];",
            "",
            "                for (int layer = 1; layer < MidLayerDepth.Length - 1; layer++)",
            "                {",
            "                    newVals[layer] = LinearInterpolate(MidLayerDepth[layer], newDepths, InputArray, numDig);",
            "                }",
            "                return (newVals);",
            "            }",
            "            return (InputArray);",
            "        }",
            "    }",
            "}"
          ],
          "Parameters": [
            {
              "Key": "ResetDateSM",
              "Value": ""
            },
            {
              "Key": "ResetDateCN",
              "Value": ""
            },
            {
              "Key": "InitDepth",
              "Value": "150, 300, 600, 900, 1200"
            },
            {
              "Key": "InitWater",
              "Value": ""
            },
            {
              "Key": "InitNO3N",
              "Value": ""
            },
            {
              "Key": "InitNH4N",
              "Value": ""
            },
            {
              "Key": "InitOC",
              "Value": ""
            }
          ],
          "Name": "Initials",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
        {
          "$type": "Models.Manager, Models",
          "CodeArray": [
            "using Models.Soils.Nutrients;",
            "using APSIM.Shared.Utilities;",
            "using Models.Surface;",
            "using Models.Utilities;",
            "using Models.Soils.Nutrients;",
            "using Models.Soils;",
            "using Models.PMF;",
            "using Models.Core;",
            "using System;",
            "using System.Linq;",
            "using Models.Interfaces;",
            "",
            "namespace Models",
            "{",
            "\t[Serializable]",
            "\tpublic class Script : Model",
            "\t{",
            "\t\t[Link] private Clock Clock;",
            "\t\t[Link] private IWeather Weather;",
            "\t\t",
            "\t\t[Description(\"Coefficient of x^3\")]",
            "\t\tpublic double C3 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Coefficient of x^2\")]",
            "\t\tpublic double C2 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Coefficient of x)\")]",
            "\t\tpublic double C1 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Intercept\")]",
            "\t\tpublic double C0 {get; set;}",
            "\t\t",
            "\t\t[Description(\"Target period (negative to use regression; set 0 to keep at 350 ppm; or 2030-2050)\")]",
            "\t\tpublic double Target {get; set;}",
            "\t\t",
            "\t\t[Description(\"RCP scenario (only used if Target>0)\")]",
            "\t\tpublic string RCP {get; set;}",
            "\t\t",
            "\t\t[Description(\"Keep CO2 at this level (only used if Target<0; negative to ignore)\")]",
            "\t\tpublic double KeepAt {get; set;}",
            "\t\t",
            "\t\t[Description(\"Keep CO2 at this year's level (only used if Target<0; negative to ignore)\")]",
            "\t\tpublic double KeepAtYear {get; set;}",
            "\t\tprivate double CO2;",
            "\t\tprivate double MonID;",
            "\t\t",
            "\t\t[EventSubscribe(\"DoWeather\")]",
            "\t\tprivate void OnDoWeather(object sender, EventArgs e)",
            "\t\t{",
            "\t\t\tCO2 = -1;",
            "\t\t\tif (Target == 0)",
            "\t\t\t{",
            "\t\t\t\tCO2 = 350;",
            "\t\t\t}",
            "\t\t\telse if (Target > 0)",
            "\t\t\t{",
            "\t\t\t\tif (Target == 2030)",
            "\t\t\t\t{",
            "\t\t\t\t\tif (RCP == \"RCP45\")",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 438;",
            "\t\t\t\t\t}",
            "\t\t\t\t\telse",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 452;",
            "\t\t\t\t\t}",
            "\t\t\t\t}",
            "\t\t\t\telse if (Target == 2050)",
            "\t\t\t\t{",
            "\t\t\t\t\tif (RCP == \"RCP45\")",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 483;",
            "\t\t\t\t\t}",
            "\t\t\t\t\telse",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tCO2 = 546;",
            "\t\t\t\t\t}",
            "\t\t\t\t}",
            "\t\t\t}",
            "\t\t\telse if (Target < 0)",
            "\t\t\t{",
            "\t\t\t\tif (KeepAt < 0)",
            "\t\t\t\t{",
            "\t\t\t\t\tif (KeepAtYear < 0)",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tMonID = (Clock.Today.Year - 1) * 12 + (Clock.Today.Month - 1) + (Clock.Today.Day / 30) - 23483.5;",
            "\t\t\t\t\t}",
            "\t\t\t\t\telse",
            "\t\t\t\t\t{",
            "\t\t\t\t\t\tMonID = (KeepAtYear - 1) * 12 + 1 - 23483.5;",
            "\t\t\t\t\t}",
            "\t\t\t\t\tCO2 = (C3 * Math.Pow(MonID,3)) + (C2 * Math.Pow(MonID,2)) + (C1 * MonID) + C0;",
            "\t\t\t\t}",
            "\t\t\t\telse",
            "\t\t\t\t{",
            "\t\t\t\t\tCO2 = KeepAt;",
            "\t\t\t\t}",
            "\t\t\t\tif (CO2 < 350)",
            "\t\t\t\t{",
            "\t\t\t\t\tCO2 = 350;",
            "\t\t\t\t}",
            "\t\t\t}",
            "\t\t\tWeather.CO2 = CO2;",
            "\t\t}",
            "\t}",
            "}"
          ],
          "Parameters": [
            {
              "Key": "C3",
              "Value": "1.4507E-08"
            },
            {
              "Key": "C2",
              "Value": "8.0117411E-05"
            },
            {
              "Key": "C1",
              "Value": "0.057666049"
            },
            {
              "Key": "C0",
              "Value": "314.802402"
            },
            {
              "Key": "Target",
              "Value": "-1"
            },
            {
              "Key": "RCP",
              "Value": "RCP85"
            },
            {
              "Key": "KeepAt",
              "Value": "-1"
            },
            {
              "Key": "KeepAtYear",
              "Value": "-1"
            }
          ],
          "Name": "CO2Trend",
          "ResourceName": null,
          "Children": [],
          "Enabled": true,
          "ReadOnly": false
        },
