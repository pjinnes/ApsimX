            {
              "$type": "Models.Factorial.Experiment, Models",
              "DisabledSimNames": null,
              "Name": "KununurraIrrigation",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "This experiment uses a fertiliser factor to simulate an N-rate trial, using the range syntax. The graph shows the effect of the fertiliser applications on soil nitrate level in each treatment.",
                  "Name": "README",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Factorial.Factors, Models",
                  "Name": "Factors",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Factorial.Permutation, Models",
                      "Name": "2011_",
                      "ResourceName": null,
                      "Children": [
                        {
                          "$type": "Models.Factorial.CompositeFactor, Models",
                          "Specifications": [
                            "[SesameManager].Script.SowingDate = 25/02/2011",
                            "[SesameManager].Script.HarvestDate = 25/09/2011",
                            "[SesameManager].Script.EndCropDate = 25/09/2011",
                            "[Clock].StartDate = 01/01/2011",
                            "[Clock].EndDate = 30/09/2011"
                          ],
                          "Paths": null,
                          "Values": null,
                          "Name": "mm",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Factorial.Factor, Models",
                          "Specification": "[IrrigationRule].Script.Amount = 0 to 40 step 10",
                          "Name": "Irrig_",
                          "ResourceName": null,
                          "Children": [],
                          "Enabled": true,
                          "ReadOnly": false
                        },
                        {
                          "$type": "Models.Factorial.Permutation, Models",
                          "Name": "2011_",
                          "ResourceName": null,
                          "Children": [
                            {
                              "$type": "Models.Factorial.CompositeFactor, Models",
