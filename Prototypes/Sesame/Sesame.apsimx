                            },
                            {
                              "$type": "Models.Surface.SurfaceOrganicMatter, Models",
                              "SurfOM": [],
                              "Canopies": [],
                              "InitialResidueName": "fallow",
                              "InitialResidueType": "Sesame",
                              "InitialResidueMass": 100.0,
                              "InitialStandingFraction": 0.5,
                              "InitialCPR": 0.0,
                              "InitialCNR": 55.0,
