                                },
                                {
                                  "Key": "WillRunoff",
                                  "Value": "False"
                                },
                                {
                                  "Key": "FertiliseDates",
                                  "Value": "01-mar, 01-may, 01-jul, 01-sep, 01-nov"
                                },
                                {
                                  "Key": "FertiliseAmount",
                                  "Value": "50"
                                },
                                {
                                  "Key": "HarvestDate",
                                  "Value": "06/10/2023 00:00:00"
                                },
                                {
                                  "Key": "EndCropDate",
                                  "Value": "06/10/2023 00:00:00"
                                }
                              ],
