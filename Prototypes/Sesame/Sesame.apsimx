                            "[Grain].Wt*10 as GrainWt",
                            "",
                            "[Leaf].Fw",
                            "[Leaf].Fn",
                            "[Leaf].Photosynthesis.FN",
                            "sum([Soil].Water.MM) as TotalSWC",
                            "sum([Soil].Physical.DULmm) as TotalDUL",
                            "sum([Soil].Physical.LL15mm) as TotalLL15",
                            "[Sesame].Phenology.Stage",
                            "[Sesame].Phenology.CurrentStageName as CurrentStageName",
                            "[Sesame].Phenology.AccumulatedTT",
                            "[Sesame].DaysAfterSowing",
                            "[Stem].BranchNumber",
                            "[Stem].BAR",
                            "[Sesame].AboveGround.Wt*10 as AboveGroundWt"
                          ],
                          "EventNames": [
                            "[Clock].EndOfDay"
                          ],
                          "GroupByVariableName": null,
                          "Name": "Report",
                          "ResourceName": null,
