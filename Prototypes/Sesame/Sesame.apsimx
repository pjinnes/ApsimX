                                  "Key": "AutoIrrigationOn",
                                  "Value": "True"
                                },
                                {
                                  "Key": "FASWThreshold",
                                  "Value": "0.4"
                                },
                                {
                                  "Key": "FASWDepth",
                                  "Value": "300"
                                },
                                {
                                  "Key": "weeks",
                                  "Value": "0"
                                },
                                {
                                  "Key": "afterSowing",
                                  "Value": "0"
                                }
                              ],
