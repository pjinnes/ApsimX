          "Children": [
            {
              "$type": "Models.Tests, Models",
              "AcceptedStats": [
                {
                  "$type": "APSIM.Numerics.MathUtilities+RegrStats, APSIM.Numerics",
                  "Name": "Sesame.AboveGround.Wt",
                  "n": 18,
                  "Slope": 0.814907983232506,
                  "Intercept": 58.784038328735164,
                  "SEslope": 0.12089305262986039,
                  "SEintercept": 43.04589495383506,
                  "R2": 0.7395727492381274,
                  "RMSE": 56.57512655365547,
