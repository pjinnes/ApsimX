                  "Name": "LaiDead",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "No specific data for area of dead leaves were found for perennial grain. The value of SLA is thus assumed to be the same as that of live leaves (this is consistent for the model as very little biomass reallocation of biomass occurs during senescence). ",
                      "Name": "Description",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
