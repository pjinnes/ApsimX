                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock clock;",
                "        [Link] private IPlant crop;      ",
                "        [Link] private Summary summary;",
                "        [Link] private SimpleLeaf leaf;",
                "        [Link] private BiomassRemoval biomassRemoval;",
                "        [Link] private Phenology phenology;",
                "        [Link] private Plant IntermediateWheatgrass;",
                "                ",
                "\t\t[Description(\"    Live leaf fraction to remove from the field     \")]",
                "\t\tpublic double leafFracToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Dead leaf fraction to remove from the field     \")]",
                "\t\tpublic double leafDeadToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Live leaf fraction to residue     \")]",
                "\t\tpublic double leafFracToResidue { get; set; } = 0;",
                "\t\t[Description(\"    Dead leaf fraction to residue     \")]",
                "\t\tpublic double leafDeadToResidue { get; set; } = 0;\t\t",
                "\t",
                " \t\t[Description(\"    Live stem fraction to remove from the field     \")]",
                "\t\tpublic double stemFracToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Dead stem fraction to remove from the field     \")]",
                "\t\tpublic double stemDeadToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Live stem fraction to residue     \")]",
                "\t\tpublic double stemFracToResidue { get; set; } = 0;",
                "\t\t[Description(\"    Dead stem fraction to residue     \")]",
                "\t\tpublic double stemDeadToResidue { get; set; } = 0;\t\t",
                "\t",
                " \t\t[Description(\"    Live grain fraction to remove from the field     \")]",
                "\t\tpublic double grainFracToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Dead grain fraction to remove from the field     \")]",
                "\t\tpublic double grainDeadToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Live grain fraction to residue     \")]",
                "\t\tpublic double grainFracToResidue { get; set; } = 0;",
                "\t\t[Description(\"    Dead grain fraction to residue     \")]",
                "\t\tpublic double grainDeadToResidue { get; set; } = 0;\t\t",
                "\t",
                " \t\t[Description(\"    Live spike fraction to remove from the field     \")]",
                "\t\tpublic double spikeFracToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Dead spike fraction to remove from the field     \")]",
                "\t\tpublic double spikeDeadToRemove { get; set; } = 1.0;",
                "\t\t[Description(\"    Live spike fraction to residue     \")]",
                "\t\tpublic double spikeFracToResidue { get; set; } = 0;",
                "\t\t[Description(\"    Dead spike fraction to residue     \")]",
                "\t\tpublic double spikeDeadToResidue { get; set; } = 0;\t\t",
                "\t",
                "  \t\t[Description(\"    Live root fraction to remove from the field     \")]",
                "\t\tpublic double rootFracToRemove { get; set; } = 0;",
                "\t\t[Description(\"    Dead root fraction to remove from the field     \")]",
                "\t\tpublic double rootDeadToRemove { get; set; } = 0;",
                "\t\t[Description(\"    Live root fraction to residue     \")]",
                "\t\tpublic double rootFracToResidue { get; set; } = 0;",
                "\t\t[Description(\"    Dead root fraction to residue     \")]",
                "\t\tpublic double rootDeadToResidue { get; set; } = 0;\t\t",
                "     ",
                "        private bool writeToSummary = true;",
                "        ",
                "  \t\tprivate enum Stage { Sowing, Germination, Emergence, Induction, StemElongation, Flowering, ",
                "  \t\tRipening, Mature, Rewind }",
                "        ",
                " ",
                "        [EventSubscribe(\"Cutting\")]      ",
                "        private void OnDoCutting(object sender, EventArgs e)",
                "        {",
                "                             ",
                "           \t// set removal fractions (these override the default removals in the plant)",
                "            // Actually do the biomass removal",
                "           \tvar Leaf = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Leaf\");",
                "            var Stem = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Stem\");",
                "           \tvar Grain = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Grain\");",
                "           \tvar Root = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Root\");",
                "            var Spike = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Spike\");",
                "               ",
                "           \tLeaf.RemoveBiomass(leafFracToRemove, leafDeadToRemove, leafFracToResidue, leafDeadToResidue);",
                "           \tStem.RemoveBiomass(stemFracToRemove, stemDeadToRemove, stemFracToResidue, stemDeadToResidue);",
                "           \tGrain.RemoveBiomass(grainFracToRemove, grainDeadToRemove, grainFracToResidue, grainDeadToResidue);",
                "           \tRoot.RemoveBiomass(rootFracToRemove, rootDeadToRemove, rootFracToResidue, rootDeadToResidue);",
                "           \tSpike.RemoveBiomass(spikeFracToRemove, spikeDeadToRemove, spikeFracToResidue, spikeDeadToResidue);",
                "                                   ",
                "            summary.WriteMessage(this, \"Debug** Cutting\", MessageType.Diagnostic);                              ",
                "        }",
                "        ",
                "        [EventSubscribe(\"Harvesting\")]      ",
                "        private void OnDoHarvesting(object sender, EventArgs e)",
                "        {                 ",
                "           \t// set removal fractions (these override the default removals in the plant)",
                "            // Actually do the biomass removal",
                "           \tvar Leaf = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Leaf\");",
                "            var Stem = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Stem\");",
                "           \tvar Grain = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Grain\");",
                "           \tvar Root = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Root\");",
                "            var Spike = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Spike\");",
                "               ",
                "           \tLeaf.RemoveBiomass(leafFracToRemove, leafDeadToRemove, leafFracToResidue, leafDeadToResidue);",
                "           \tStem.RemoveBiomass(stemFracToRemove, stemDeadToRemove, stemFracToResidue, stemDeadToResidue);",
                "           \tGrain.RemoveBiomass(grainFracToRemove, grainDeadToRemove, grainFracToResidue, grainDeadToResidue);",
                "           \tRoot.RemoveBiomass(rootFracToRemove, rootDeadToRemove, rootFracToResidue, rootDeadToResidue);",
                "           \tSpike.RemoveBiomass(spikeFracToRemove, spikeDeadToRemove, spikeFracToResidue, spikeDeadToResidue);",
                "                                   ",
                "            summary.WriteMessage(this, \"Debug** Harvesting\", MessageType.Diagnostic);",
                "            phenology.SetToStage((double)Stage.Emergence);                             ",
                "        }",
                "    }",
                "}"
