            {
              "$type": "Models.Report, Models",
              "VariableNames": [
                "[Clock].Today as Date",
                "",
                "[IntermediateWheatgrass].Population",
                "[IntermediateWheatgrass].PlantType",
                "[IntermediateWheatgrass].Leaf.RadiationIntercepted as InterceptedRadiation",
                "",
                "[IntermediateWheatgrass].AboveGround.Wt*10 as totalBiomass",
                "[IntermediateWheatgrass].BelowGround.Wt*10 as Roots",
                "[IntermediateWheatgrass].Leaf.Live.NConc",
                "[IntermediateWheatgrass].Leaf.LAI*100",
                "[IntermediateWheatgrass].Leaf.Live.Wt*10 as LeavesWeight",
                "[IntermediateWheatgrass].Stem.Live.Wt*10 as StemsWeight",
                "[IntermediateWheatgrass].Spike.Live.Wt*10 as SpikesWeight",
                "[IntermediateWheatgrass].Grain.Live.Wt*10 as GrainWeight",
                "[IntermediateWheatgrass].Root.Live.Wt*10 as RootsWeight",
                "[IntermediateWheatgrass].Leaf.Senesced.Wt*10 as LeavesDeadWeight",
                "[IntermediateWheatgrass].Stem.Senesced.Wt*10 as StemsDeadWeight",
                "[IntermediateWheatgrass].Spike.Senesced.Wt*10 as SpikesDeadWeight",
                "",
                "[IntermediateWheatgrass].Phenology.CurrentStageName",
                "[IntermediateWheatgrass].Phenology.CurrentPhaseName",
                "[IntermediateWheatgrass].Phenology.Stage",
                "[IntermediateWheatgrass].Phenology.Photoperiod",
                "[Phenology].Vernalisation.TodaysVernalisation*100",
                "[Phenology].Vernalisation.VernalisingDays",
                "[Phenology].Vernalisation.DaysVernalised",
                "LeavesWeight+LeavesDeadWeight+StemsWeight+StemsDeadWeight+SpikesWeight+SpikesDeadWeight+GrainWeight as AboveGndBiomass",
                "[Phenology].StageToZadok",
                "[IntermediateWheatgrass].Phenology.AccumulatedTT",
                "[IntermediateWheatgrass].Phenology.ThermalStress",
                "[Leaf].Fw",
                "[Leaf].Fn",
                "[Phenology].Reproductive.Progression",
                "[Phenology].ThermalTime"
              ],
              "EventNames": [
                "[Clock].EndOfDay"
              ],
              "GroupByVariableName": null,
              "Name": "Report",
              "ResourceName": null,
