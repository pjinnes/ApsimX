              "ReadOnly": false
            },
            {
              "$type": "Models.Manager, Models",
              "CodeArray": [
                "using Models.Soils;",
                "using System;",
                "using System.Linq;",
                "using Models.Core;",
                "using Models.PMF;",
                "using Models.PMF.Interfaces;",
                "",
                "using APSIM.Shared.Utilities;",
                "using Models.Surface;",
                "using Models.Utilities;",
                "using Models.Soils.Nutrients;",
                "using Models.Interfaces;",
                "using Models.PMF.Organs;",
                "using Models.PMF.Library;",
                "using Models.PMF.Phen;",
                "using Newtonsoft.Json;",
                "using Models.DCAPST.Interfaces;",
                "using Models.Functions;",
                "",
                "namespace Models",
                "{",
                "    [Serializable]",
                "    public class Script : Model",
                "    {",
                "        [Link] private Clock clock;",
                "        [Link] private IPlant crop;      ",
                "        [Link] private Summary Summary;",
                "        [Link] private SimpleLeaf leaf;",
                "        [Link] private BiomassRemoval biomassRemoval;",
                "        [Link] private Phenology phenology;",
                "        [Link] private Plant IntermediateWheatgrass;",
                "        [Link] private Zone zone;",
                "        ",
                "",
                "\t\t[Link(ByName=true)] private SubDailyInterpolation ThermalStress;",
                "\t\t[Link(ByName=true)] private Constant ThermalStressThreshold;",
                "\t\t[Link(ByName=true)] private LinearInterpolationFunction FW;",
                "\t\t[Link(ByName=true)] private Constant FWThreshold;",
                "\t\t[Link(ByName=true)] private VariableReference FWPhen;",
                "",
                "        private double leafFracToRemove = 0.05;",
                "        private double leafFracToResidue = 0.05;",
                "        private double leafDeadToRemove = 0.0;",
                "        private double leafDeadToResidue = 0.0;",
                "        private double stemFracToRemove = 0.05;",
                "        private double stemFracToResidue = 0.05;",
                "        private double stemDeadToRemove = 0.0;",
                "        private double stemDeadToResidue = 0.0;",
                "        private double grainFracToRemove = 0.0;",
                "        private double grainFracToResidue = 0.0;",
                "        private double grainDeadToRemove = 0.0;",
                "        private double grainDeadToResidue = 0.0;",
                "        private double rootFracToRemove = 0.0;",
                "        private double rootFracToResidue = 0.0;",
                "        private double rootDeadToRemove = 0.0;",
                "        private double rootDeadToResidue = 0.0;",
                "        private double spikeFracToRemove = 0.0;",
                "        private double spikeFracToResidue = 0.0;",
                "        private double spikeDeadToRemove = 0.0;",
                "        private double spikeDeadToResidue = 0.0;",
                "      ",
                "        private double accumulatedTempStress = 0;   ",
                "        private bool writeToSummary = true;",
                "        private bool harvestWhenRipe = true;",
                "        ",
                "        //Delayed plantings of perennials in the fall can result in stand mortality and subsequent reductions",
                "        //in biomass yields the year following seeding (Hall, 1995)",
                "        private bool delayedGermination = false;",
                "        ",
                "  \t\tprivate enum Stage { Sowing, Germinating, Emerging, Vernalising, Inducing, Reproductive, GrainFilling, Maturing, Harvest, GotoPhase }",
                "        ",
                "        [EventSubscribe(\"EndOfDay\")]      ",
                "        private void OnDoManagementCalculations(object sender, EventArgs e)",
                "        {",
                "        \tSummary.WriteMessage(this,phenology.CurrentPhaseName, MessageType.Diagnostic);",
                "",
                "            // The following code is designed to capture the effects of temperature stress on the early reproductive stages",
                "            // of a perennial grain. If the acummualted temperature are above a designated threshold, and there is water stress,",
                "            // then consider the reproductive organs have suffered ireversable damage and rewind to the inducing/vegetative stage",
                "            //",
                "            if (phenology.CurrentPhaseName == \"Reproductive\")",
                "            { ",
                "            \tdouble tempStress = ThermalStress.Value();",
                "            \tdouble stressThreshold = ThermalStressThreshold.Value();",
                "            \tdouble waterStress = FWPhen.Value();",
                "            \tdouble wsThreshold = FWThreshold.Value();",
                "               \t",
                "               \taccumulatedTempStress += tempStress;",
                "                 ",
                "            \tSummary.WriteMessage(this, \"accumulatedTempStress = \"+ accumulatedTempStress, MessageType.Diagnostic);",
                "            \tSummary.WriteMessage(this, \"stressThreshold = \"+ stressThreshold, MessageType.Diagnostic);",
                "            \tSummary.WriteMessage(this, \"waterStress = \"+ waterStress, MessageType.Diagnostic);",
                "            \tSummary.WriteMessage(this, \"watereStressThreshold = \"+ wsThreshold, MessageType.Diagnostic);",
                "            \t",
                "            \tif((accumulatedTempStress > stressThreshold)&&(waterStress < wsThreshold))",
                "            \t{           \t              \t",
                "                \tphenology.SetToStage((double)Stage.Inducing);",
                "               \t\tSummary.WriteMessage(this, \"Debug** Set to Inducing Stage\", MessageType.Diagnostic);",
                "               \t\taccumulatedTempStress = 0;",
                "               \t\tSummary.WriteMessage(this, \"accumulatedTempStress = \"+accumulatedTempStress+\" FW=\"+waterStress, MessageType.Diagnostic);",
                "               \t}",
                "            }",
                "            ",
                "            if (phenology.CurrentPhaseName == \"GrainRipening\")",
                "            {   ",
                "                accumulatedTempStress = 0;",
                "                Summary.WriteMessage(this, \"Maturing: accumulatedTempStress = \"+ accumulatedTempStress, MessageType.Diagnostic); ",
                "            }",
                "        }",
                "        ",
                "        [EventSubscribe(\"EndOfDay\")]",
                "        private void OnEndOfDay(object sender, EventArgs e)",
                "        {",
                "            Summary.WriteMessage(this, \"PhaseName = \"+ phenology.CurrentPhaseName + \" population = \" + IntermediateWheatgrass.Population, MessageType.Diagnostic);",
                "            if (phenology.CurrentPhaseName == \"Emerging\")",
                "            {",
                "                if (IntermediateWheatgrass.DaysAfterSowing > 30)",
                "                {  ",
                "                    delayedGermination = true;",
                "                }",
                "            }    ",
                "                    ",
                "            if (delayedGermination)",
                "            {",
                "                // set removal fractions (these override the default removals in the plant)",
                "                // Actually do the biomass removal",
                "           \t    var Leaf = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Leaf\");",
                "                var Stem = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Stem\");",
                "           \t    var Grain = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Grain\");",
                "           \t    var Root = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Root\");",
                "                var Spike = IntermediateWheatgrass.FindChild<IHasDamageableBiomass>(\"Spike\");",
                "               ",
                "           \t    Leaf.RemoveBiomass(leafFracToRemove, leafDeadToRemove, leafFracToResidue, leafDeadToResidue);",
                "           \t    Stem.RemoveBiomass(stemFracToRemove, stemDeadToRemove, stemFracToResidue, stemDeadToResidue);",
                "           \t    Grain.RemoveBiomass(grainFracToRemove, grainDeadToRemove, grainFracToResidue, grainDeadToResidue);",
                "           \t    Root.RemoveBiomass(rootFracToRemove, rootDeadToRemove, rootFracToResidue, rootDeadToResidue);",
                "           \t    Spike.RemoveBiomass(spikeFracToRemove, spikeDeadToRemove, spikeFracToResidue, spikeDeadToResidue);",
                "                                   ",
                "                Summary.WriteMessage(this, \"Debug** RemoveBiomass\", MessageType.Diagnostic);      ",
                "            }             ",
                "        }    ",
                "    }",
                "}",
                ""
              ],
              "Parameters": [],
              "Name": "PhenologyRulesDAS",
              "ResourceName": null,
              "Children": [],
              "Enabled": true,
              "ReadOnly": false
            }
          ],
          "Enabled": true,
          "ReadOnly": false
        },
