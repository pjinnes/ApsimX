            {
              "$type": "Models.PMF.Organs.SimpleLeaf, Models",
              "Albedo": 0.18,
              "Gsmax350": 0.015,
              "R50": 150.0,
              "LeafInitialisationStage": "Emergence",
              "Height": 0.0,
              "BaseHeight": 0.0,
              "Width": 0.0,
              "FRGR": 0.0,
              "PotentialEP": 0.0,
              "WaterDemand": 0.0,
              "LightProfile": null,
              "KDead": 0.0,
              "LAIDead": 0.0,
              "DMSupply": null,
              "NSupply": null,
              "DMDemand": null,
              "NDemand": null,
              "potentialDMAllocation": null,
              "Name": "Leaf",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "__Note:__ this organ represents all the leaves in the plant, it has only a basic representation of canopy structure and does not distinguish leaves for ages or placement in the canopy.  \r\n",
                  "Name": "Description",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.MultiplyFunction, Models",
                  "Name": "InitialWt",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "It is assumed that approximately 1/3 of the seed biomass is allocated to shoot upon emergence.  The weight of perennial grain seeds varies.  \n",
                      "Name": "Description",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.Constant, Models",
                      "FixedValue": 0.015,
                      "Units": "g/plant",
                      "Name": "InitialOrganWt",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    },
                    {
                      "$type": "Models.Functions.VariableReference, Models",
                      "VariableName": "[Plant].Population",
                      "Name": "Population",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.4,
                  "Units": null,
                  "Name": "CarbonConcentration",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This is the default value for PMF. ",
                      "Name": "Description",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.0275,
                  "Units": "gN/gDM",
                  "Name": "MinimumNConc",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This is the lowest N concentration that leaves can have and still be able to grow.  It represents the N content for structural tissues and is the concentration of dead material. ",
                      "Name": "Description",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.05,
                  "Units": "gN/gDM",
                  "Name": "CriticalNConc",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This is the N concentration that the organ must have to perform its functions without limitations; a growth penalty will occurr if N level fall below this threshold.  No values have been clearly identifyied for this parameter in perennial grain, thus typical values for non-stressed plants are used instead. \r\n",
                      "Name": "Description",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 0.06,
                  "Units": "gN/gDM",
                  "Name": "MaximumNConc",
                  "ResourceName": null,
                  "Children": [
                    {
                      "$type": "Models.Memo, Models",
                      "Text": "This represents the maximum limit for N concentration in leaves.  The N content above CriticalNConc is not essential for growth and can be remobilised for new growth when uptake is insuficient. \n",
                      "Name": "Description",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Functions.Constant, Models",
                  "FixedValue": 1.0,
                  "Units": null,
                  "Name": "NitrogenDemandSwitch",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": true,
                  "ReadOnly": false
                },
